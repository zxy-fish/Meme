{
  "name": "meme",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "description": "Meme — a local-first personal media library, bookmark shelf and reader.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "desktop:smoke": "electron . --smoke",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "jschardet": "^4.1.0",
    "lucide-react": "^1.69.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.16"
  },
  "main": "electron/main.cjs",
  "author": "zxy-fish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxy-fish/Meme.git"
  },
  "homepage": "https://zxy-fish.github.io/Meme/",
  "bugs": {
    "url": "https://github.com/zxy-fish/Meme/issues"
  }
}
